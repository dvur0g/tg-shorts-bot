# Copy to .env and fill in. Never commit .env.

# Required: token from @BotFather
BOT_TOKEN=

# Comma-separated chat ids the bot serves; empty = any chat.
# The bot logs the id of every chat it sees, so you can copy it from the logs.
ALLOWED_CHAT_IDS=

# Skip videos longer than this (seconds)
MAX_DURATION_SEC=180
# Max upload size in MB (Telegram Bot API limit is 50)
MAX_FILE_MB=49
# Kill a download that takes longer than this (seconds)
DOWNLOAD_TIMEOUT_SEC=120
# Parallel downloads
WORKER_THREADS=2
# Temporary working directory for downloads (a tmpfs in docker compose)
DOWNLOAD_DIR=/tmp/shortsbot

# yt-dlp binary
YTDLP_PATH=yt-dlp
# Optional Netscape-format cookies file (mostly needed for Instagram).
# With docker compose: put it in ./secrets/ and use /app/secrets/cookies.txt
YTDLP_COOKIES_FILE=
# Run "yt-dlp -U" on startup
YTDLP_AUTO_UPDATE=false

# Reply with a short message when a video can't be downloaded
REPLY_WITH_ERRORS=true

# Route all traffic through an Outline/Shadowsocks server (not implemented yet)
VPN_ENABLED=false
VPN_SS_URL=

# TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
